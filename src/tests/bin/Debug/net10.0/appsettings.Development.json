{
  "Persistence": {
    "Provider": "InMemory",
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "TaskManager.Api",
    "Audience": "TaskManager.Client",
    "SigningKey": "this-is-a-dev-only-signing-key-change-in-production-12345",
    "TokenExpirationMinutes": 60
  },
  "OpenTelemetry": {
    "ServiceName": "dotnet-task-manager-api-dev",
    "ConsoleExporterEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
