<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>OpenTelemetry.Exporter.OpenTelemetryProtocol</id>
    <version>1.9.0</version>
    <authors>OpenTelemetry Authors</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>opentelemetry-icon-color.png</icon>
    <projectUrl>https://opentelemetry.io/</projectUrl>
    <description>OpenTelemetry protocol exporter for OpenTelemetry .NET</description>
    <copyright>Copyright The OpenTelemetry Authors</copyright>
    <tags>Observability OpenTelemetry Monitoring Telemetry Tracing Metrics Logging OTLP</tags>
    <repository type="git" url="https://github.com/open-telemetry/opentelemetry-dotnet" commit="df260790f0a9bc35c7c4842fbc44d93e9a6d182c" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="OpenTelemetry" version="1.9.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="[3.22.5, 4.0.0)" exclude="Build,Analyzers" />
        <dependency id="Grpc" version="[2.44.0, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="8.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="OpenTelemetry" version="1.9.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="[3.22.5, 4.0.0)" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="[2.52.0, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="8.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="OpenTelemetry" version="1.9.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="[3.22.5, 4.0.0)" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="[2.52.0, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="8.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="OpenTelemetry" version="1.9.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="[3.22.5, 4.0.0)" exclude="Build,Analyzers" />
        <dependency id="Grpc" version="[2.44.0, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="8.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="OpenTelemetry" version="1.9.0" exclude="Build,Analyzers" />
        <dependency id="Google.Protobuf" version="[3.22.5, 4.0.0)" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="[2.52.0, 3.0.0)" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="8.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Net.Http" targetFramework=".NETFramework4.6.2" />
    </frameworkAssemblies>
  </metadata>
</package>